# Dependencies (mỗi bài là một project riêng, mỗi project có node_modules riêng)
node_modules/

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Vite / tool cache
.vite/
.eslintcache
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Môi trường và bí mật
.env
.env.*
!.env.example

# Hệ điều hành
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.idea/
*.swp
*.swo
